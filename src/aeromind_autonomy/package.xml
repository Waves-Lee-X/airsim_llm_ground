<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aeromind_autonomy</name>
  <version>0.1.0</version>
  <description>Real-time local autonomy: ESDF-style mapping, kinodynamic replanning and smooth trajectory output.</description>
  <maintainer email="team@aeromind.local">AeroMind Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>aeromind_interfaces</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
