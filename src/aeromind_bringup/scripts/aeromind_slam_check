#!/usr/bin/env python3
"""Read-only RTAB-Map deployment check."""

from __future__ import annotations

import subprocess
import sys


REQUIRED_TOPICS = {
    "/sensor/camera/rgb/front_center",
    "/sensor/camera/rgb/front_center/camera_info",
    "/sensor/camera/depth/front_center",
    "/sensor/odometry",
    "/localization/odometry",
    "/localization/status",
}


def run(command, timeout=5.0):
    try:
        result = subprocess.run(
            command,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
        return result.returncode, result.stdout.strip(), result.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 124, "", str(exc)


def main():
    checks = []
    code, output, error = run(["ros2", "pkg", "prefix", "rtabmap_slam"])
    checks.append((code == 0, "RTAB-Map 系统包", output or error or "未安装"))

    code, output, error = run(["ros2", "topic", "list"])
    topics = {line.strip() for line in output.splitlines() if line.strip()} if code == 0 else set()
    missing = sorted(REQUIRED_TOPICS - topics)
    checks.append((not missing, "SLAM 关键话题", "全部存在" if not missing else "缺少: " + ", ".join(missing)))

    code, output, error = run(
        ["ros2", "topic", "echo", "/localization/status", "--once"], timeout=4.0
    )
    healthy = code == 0 and '"healthy": true' in output.lower()
    checks.append((healthy, "SLAM 健康状态", output or error or "无数据"))

    code, output, error = run(
        ["ros2", "run", "tf2_ros", "tf2_echo", "map", "odom"], timeout=3.0
    )
    tf_seen = "Translation:" in output and "Rotation:" in output
    checks.append((tf_seen, "TF map -> odom", "转换可用" if tf_seen else error or output or "无转换"))

    print("\nRTAB-Map SLAM 验收检查")
    for passed, name, detail in checks:
        compact = " ".join(detail.split())[:240]
        print(f"[{'PASS' if passed else 'FAIL'}] {name}: {compact}")
    failures = sum(not passed for passed, _, _ in checks)
    print(f"\nPASS={len(checks) - failures} FAIL={failures}")
    return 0 if failures == 0 else 2


if __name__ == "__main__":
    sys.exit(main())

