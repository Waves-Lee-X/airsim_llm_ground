{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0",
  "schemas": {
    "fleet_config": {
      "$defs": {
        "DeploymentMode": {
          "enum": [
            "sim",
            "real"
          ],
          "title": "DeploymentMode",
          "type": "string"
        },
        "FcuConnection": {
          "additionalProperties": false,
          "properties": {
            "baudrate": {
              "anyOf": [
                {
                  "maximum": 2000000,
                  "minimum": 9600,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Baudrate"
            },
            "endpoint": {
              "maxLength": 256,
              "minLength": 1,
              "title": "Endpoint",
              "type": "string"
            },
            "source_component": {
              "default": 191,
              "maximum": 255,
              "minimum": 1,
              "title": "Source Component",
              "type": "integer"
            },
            "source_system": {
              "maximum": 254,
              "minimum": 200,
              "title": "Source System",
              "type": "integer"
            },
            "target_component": {
              "default": 1,
              "maximum": 255,
              "minimum": 1,
              "title": "Target Component",
              "type": "integer"
            },
            "target_system": {
              "maximum": 255,
              "minimum": 1,
              "title": "Target System",
              "type": "integer"
            },
            "transport": {
              "$ref": "#/$defs/FcuTransport"
            }
          },
          "required": [
            "transport",
            "endpoint",
            "source_system",
            "target_system"
          ],
          "title": "FcuConnection",
          "type": "object"
        },
        "FcuTransport": {
          "enum": [
            "udp",
            "serial"
          ],
          "title": "FcuTransport",
          "type": "string"
        },
        "GroundConnection": {
          "additionalProperties": false,
          "properties": {
            "baudrate": {
              "default": 57600,
              "maximum": 921600,
              "minimum": 9600,
              "title": "Baudrate",
              "type": "integer"
            },
            "endpoint": {
              "maxLength": 256,
              "minLength": 1,
              "title": "Endpoint",
              "type": "string"
            },
            "transport": {
              "$ref": "#/$defs/GroundTransport",
              "default": "serial"
            }
          },
          "required": [
            "endpoint"
          ],
          "title": "GroundConnection",
          "type": "object"
        },
        "GroundTransport": {
          "enum": [
            "serial"
          ],
          "title": "GroundTransport",
          "type": "string"
        },
        "SensorSourceKind": {
          "enum": [
            "none",
            "airsim",
            "realsense",
            "replay"
          ],
          "title": "SensorSourceKind",
          "type": "string"
        },
        "VehicleRuntimeConfig": {
          "additionalProperties": false,
          "properties": {
            "ack_timeout_s": {
              "default": 2.0,
              "maximum": 30.0,
              "minimum": 0.2,
              "title": "Ack Timeout S",
              "type": "number"
            },
            "companion_heartbeat_hz": {
              "default": 1.0,
              "maximum": 5.0,
              "minimum": 0.5,
              "title": "Companion Heartbeat Hz",
              "type": "number"
            },
            "completion_hold_s": {
              "default": 0.5,
              "maximum": 5.0,
              "minimum": 0.1,
              "title": "Completion Hold S",
              "type": "number"
            },
            "credential_env": {
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "title": "Credential Env",
              "type": "string"
            },
            "fcu": {
              "$ref": "#/$defs/FcuConnection"
            },
            "frame_calibration_id": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Frame Calibration Id",
              "type": "string"
            },
            "ground_link": {
              "anyOf": [
                {
                  "$ref": "#/$defs/GroundConnection"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "guided_mode": {
              "default": "GUIDED",
              "pattern": "^[A-Z][A-Z0-9_]{1,31}$",
              "title": "Guided Mode",
              "type": "string"
            },
            "heartbeat_timeout_s": {
              "default": 3.0,
              "maximum": 30.0,
              "minimum": 0.5,
              "title": "Heartbeat Timeout S",
              "type": "number"
            },
            "hold_mode": {
              "default": "LOITER",
              "pattern": "^[A-Z][A-Z0-9_]{1,31}$",
              "title": "Hold Mode",
              "type": "string"
            },
            "name": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Name",
              "type": "string"
            },
            "physical_timeout_s": {
              "default": 30.0,
              "maximum": 300.0,
              "minimum": 1.0,
              "title": "Physical Timeout S",
              "type": "number"
            },
            "runtime_host": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "title": "Runtime Host",
              "type": "string"
            },
            "sensor_source": {
              "$ref": "#/$defs/SensorSourceKind"
            },
            "setpoint_rate_hz": {
              "default": 20.0,
              "maximum": 50.0,
              "minimum": 10.0,
              "title": "Setpoint Rate Hz",
              "type": "number"
            },
            "startup_timeout_s": {
              "default": 5.0,
              "maximum": 60.0,
              "minimum": 1.0,
              "title": "Startup Timeout S",
              "type": "number"
            },
            "telemetry_freshness_s": {
              "default": 1.0,
              "maximum": 10.0,
              "minimum": 0.1,
              "title": "Telemetry Freshness S",
              "type": "number"
            },
            "trajectory_timeout_ms": {
              "default": 1000,
              "maximum": 10000,
              "minimum": 250,
              "title": "Trajectory Timeout Ms",
              "type": "integer"
            },
            "vehicle_id": {
              "maximum": 255,
              "minimum": 1,
              "title": "Vehicle Id",
              "type": "integer"
            }
          },
          "required": [
            "vehicle_id",
            "name",
            "runtime_host",
            "frame_calibration_id",
            "credential_env",
            "sensor_source",
            "fcu"
          ],
          "title": "VehicleRuntimeConfig",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "fleet_name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Fleet Name",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/DeploymentMode"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "vehicles": {
          "items": {
            "$ref": "#/$defs/VehicleRuntimeConfig"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Vehicles",
          "type": "array"
        }
      },
      "required": [
        "mode",
        "fleet_name",
        "vehicles"
      ],
      "title": "FleetConfig",
      "type": "object"
    },
    "georeference": {
      "$defs": {
        "AltitudeDatum": {
          "enum": [
            "amsl",
            "wgs84_ellipsoid"
          ],
          "title": "AltitudeDatum",
          "type": "string"
        },
        "CalibrationStatus": {
          "enum": [
            "draft",
            "surveyed"
          ],
          "title": "CalibrationStatus",
          "type": "string"
        },
        "HeightReference": {
          "additionalProperties": false,
          "properties": {
            "datum": {
              "$ref": "#/$defs/AltitudeDatum",
              "default": "amsl"
            },
            "map_z_zero": {
              "const": "map_origin",
              "default": "map_origin",
              "title": "Map Z Zero",
              "type": "string"
            }
          },
          "title": "HeightReference",
          "type": "object"
        },
        "MapDefinition": {
          "additionalProperties": false,
          "properties": {
            "origin_marker": {
              "default": "O",
              "maxLength": 32,
              "minLength": 1,
              "title": "Origin Marker",
              "type": "string"
            },
            "positive_x_marker": {
              "default": "X1",
              "maxLength": 32,
              "minLength": 1,
              "title": "Positive X Marker",
              "type": "string"
            },
            "units": {
              "const": "m",
              "default": "m",
              "title": "Units",
              "type": "string"
            },
            "x_axis_reference": {
              "const": "true_north",
              "default": "true_north",
              "title": "X Axis Reference",
              "type": "string"
            },
            "z_axis": {
              "const": "up",
              "default": "up",
              "title": "Z Axis",
              "type": "string"
            }
          },
          "title": "MapDefinition",
          "type": "object"
        },
        "VehicleHome": {
          "additionalProperties": false,
          "properties": {
            "expected_wgs84": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Wgs84Position"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "map_position_m": {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "title": "Map Position M",
              "type": "array"
            },
            "vehicle_id": {
              "maximum": 255,
              "minimum": 1,
              "title": "Vehicle Id",
              "type": "integer"
            }
          },
          "required": [
            "vehicle_id",
            "map_position_m"
          ],
          "title": "VehicleHome",
          "type": "object"
        },
        "Wgs84Position": {
          "additionalProperties": false,
          "properties": {
            "altitude_m": {
              "maximum": 20000.0,
              "minimum": -1000.0,
              "title": "Altitude M",
              "type": "number"
            },
            "latitude_deg": {
              "maximum": 90.0,
              "minimum": -90.0,
              "title": "Latitude Deg",
              "type": "number"
            },
            "longitude_deg": {
              "maximum": 180.0,
              "minimum": -180.0,
              "title": "Longitude Deg",
              "type": "number"
            }
          },
          "required": [
            "latitude_deg",
            "longitude_deg",
            "altitude_m"
          ],
          "title": "Wgs84Position",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "One immutable-by-id mapping between the real venue and AirSim.",
      "properties": {
        "airsim_origin_wgs84": {
          "anyOf": [
            {
              "$ref": "#/$defs/Wgs84Position"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "calibration_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Calibration Id",
          "type": "string"
        },
        "height_reference": {
          "$ref": "#/$defs/HeightReference"
        },
        "map_definition": {
          "$ref": "#/$defs/MapDefinition"
        },
        "map_origin_wgs84": {
          "anyOf": [
            {
              "$ref": "#/$defs/Wgs84Position"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "map_scale": {
          "const": 1.0,
          "default": 1.0,
          "title": "Map Scale",
          "type": "number"
        },
        "map_x_heading_from_true_north_deg": {
          "anyOf": [
            {
              "maximum": 180.0,
              "minimum": -180.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Map X Heading From True North Deg"
        },
        "notes": {
          "default": "",
          "maxLength": 1000,
          "title": "Notes",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CalibrationStatus",
          "default": "draft"
        },
        "vehicle_homes": {
          "items": {
            "$ref": "#/$defs/VehicleHome"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Vehicle Homes",
          "type": "array"
        }
      },
      "required": [
        "calibration_id",
        "vehicle_homes"
      ],
      "title": "GeoReference",
      "type": "object"
    },
    "wire_message": {
      "$defs": {
        "AckStatus": {
          "enum": [
            "accepted",
            "running",
            "completed",
            "failed",
            "cancelled",
            "expired"
          ],
          "title": "AckStatus",
          "type": "string"
        },
        "BoxFace": {
          "enum": [
            "front",
            "back",
            "left",
            "right",
            "top",
            "unknown"
          ],
          "title": "BoxFace",
          "type": "string"
        },
        "CoordinateFrame": {
          "enum": [
            "none",
            "map",
            "local_ned",
            "global_wgs84",
            "body_frd",
            "camera_optical"
          ],
          "title": "CoordinateFrame",
          "type": "string"
        },
        "FormationCommand": {
          "additionalProperties": false,
          "properties": {
            "created_at_utc": {
              "format": "date-time",
              "title": "Created At Utc",
              "type": "string"
            },
            "frame": {
              "$ref": "#/$defs/CoordinateFrame",
              "default": "none"
            },
            "frame_calibration_id": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Frame Calibration Id"
            },
            "message_id": {
              "format": "uuid",
              "title": "Message Id",
              "type": "string"
            },
            "message_type": {
              "const": "formation_command",
              "default": "formation_command",
              "title": "Message Type",
              "type": "string"
            },
            "mission_id": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Mission Id"
            },
            "schema_version": {
              "const": "1.0",
              "default": "1.0",
              "title": "Schema Version",
              "type": "string"
            },
            "sequence": {
              "minimum": 0,
              "title": "Sequence",
              "type": "integer"
            },
            "session_id": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            },
            "shape": {
              "$ref": "#/$defs/FormationShape"
            },
            "spacing_m": {
              "maximum": 50.0,
              "minimum": 2.0,
              "title": "Spacing M",
              "type": "number"
            },
            "starts_at_utc": {
              "format": "date-time",
              "title": "Starts At Utc",
              "type": "string"
            },
            "transition_duration_s": {
              "maximum": 60.0,
              "minimum": 1.0,
              "title": "Transition Duration S",
              "type": "number"
            },
            "ttl_ms": {
              "default": 5000,
              "maximum": 300000,
              "minimum": 100,
              "title": "Ttl Ms",
              "type": "integer"
            },
            "vehicle_id": {
              "maximum": 255,
              "minimum": 1,
              "title": "Vehicle Id",
              "type": "integer"
            },
            "virtual_leader_position_m": {
              "$ref": "#/$defs/Vector3"
            }
          },
          "required": [
            "vehicle_id",
            "sequence",
            "session_id",
            "shape",
            "spacing_m",
            "transition_duration_s",
            "starts_at_utc",
            "virtual_leader_position_m"
          ],
          "title": "FormationCommand",
          "type": "object"
        },
        "FormationShape": {
          "enum": [
            "line",
            "v",
            "square"
          ],
          "title": "FormationShape",
          "type": "string"
        },
        "Heartbeat": {
          "additionalProperties": false,
          "properties": {
            "allowed_commands": {
              "default": [],
              "items": {
                "$ref": "#/$defs/VehicleCommandType"
              },
              "title": "Allowed Commands",
              "type": "array"
            },
            "command_output_enabled": {
              "default": true,
              "title": "Command Output Enabled",
              "type": "boolean"
            },
            "configuration_hash": {
              "maxLength": 128,
              "minLength": 8,
              "title": "Configuration Hash",
              "type": "string"
            },
            "created_at_utc": {
              "format": "date-time",
              "title": "Created At Utc",
              "type": "string"
            },
            "frame": {
              "$ref": "#/$defs/CoordinateFrame",
              "default": "none"
            },
            "frame_calibration_id": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Frame Calibration Id"
            },
            "last_command_message_id": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Last Command Message Id"
            },
            "message_id": {
              "format": "uuid",
              "title": "Message Id",
              "type": "string"
            },
            "message_type": {
              "const": "heartbeat",
              "default": "heartbeat",
              "title": "Message Type",
              "type": "string"
            },
            "mission_id": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Mission Id"
            },
            "schema_version": {
              "const": "1.0",
              "default": "1.0",
              "title": "Schema Version",
              "type": "string"
            },
            "sequence": {
              "minimum": 0,
              "title": "Sequence",
              "type": "integer"
            },
            "session_id": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            },
            "software_version": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Software Version",
              "type": "string"
            },
            "ttl_ms": {
              "default": 5000,
              "maximum": 300000,
              "minimum": 100,
              "title": "Ttl Ms",
              "type": "integer"
            },
            "vehicle_id": {
              "maximum": 255,
              "minimum": 1,
              "title": "Vehicle Id",
              "type": "integer"
            }
          },
          "required": [
            "vehicle_id",
            "sequence",
            "session_id",
            "software_version",
            "configuration_hash"
          ],
          "title": "Heartbeat",
          "type": "object"
        },
        "MissionAck": {
          "additionalProperties": false,
          "properties": {
            "acknowledged_message_id": {
              "format": "uuid",
              "title": "Acknowledged Message Id",
              "type": "string"
            },
            "apm_command_result": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Apm Command Result"
            },
            "created_at_utc": {
              "format": "date-time",
              "title": "Created At Utc",
              "type": "string"
            },
            "detail": {
              "default": "",
              "maxLength": 512,
              "title": "Detail",
              "type": "string"
            },
            "frame": {
              "$ref": "#/$defs/CoordinateFrame",
              "default": "none"
            },
            "frame_calibration_id": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Frame Calibration Id"
            },
            "message_id": {
              "format": "uuid",
              "title": "Message Id",
              "type": "string"
            },
            "message_type": {
              "const": "mission_ack",
              "default": "mission_ack",
              "title": "Message Type",
              "type": "string"
            },
            "mission_id": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Mission Id"
            },
            "physical_completion_confirmed": {
              "default": false,
              "title": "Physical Completion Confirmed",
              "type": "boolean"
            },
            "schema_version": {
              "const": "1.0",
              "default": "1.0",
              "title": "Schema Version",
              "type": "string"
            },
            "sequence": {
              "minimum": 0,
              "title": "Sequence",
              "type": "integer"
            },
            "session_id": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/AckStatus"
            },
            "ttl_ms": {
              "default": 5000,
              "maximum": 300000,
              "minimum": 100,
              "title": "Ttl Ms",
              "type": "integer"
            },
            "vehicle_id": {
              "maximum": 255,
              "minimum": 1,
              "title": "Vehicle Id",
              "type": "integer"
            }
          },
          "required": [
            "vehicle_id",
            "sequence",
            "session_id",
            "acknowledged_message_id",
            "status"
          ],
          "title": "MissionAck",
          "type": "object"
        },
        "Quaternion": {
          "additionalProperties": false,
          "properties": {
            "w": {
              "title": "W",
              "type": "number"
            },
            "x": {
              "title": "X",
              "type": "number"
            },
            "y": {
              "title": "Y",
              "type": "number"
            },
            "z": {
              "title": "Z",
              "type": "number"
            }
          },
          "required": [
            "w",
            "x",
            "y",
            "z"
          ],
          "title": "Quaternion",
          "type": "object"
        },
        "SemanticObservation": {
          "additionalProperties": false,
          "properties": {
            "box_id": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Box Id",
              "type": "string"
            },
            "color": {
              "maxLength": 32,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]*$",
              "title": "Color",
              "type": "string"
            },
            "confidence": {
