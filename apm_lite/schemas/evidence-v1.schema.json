{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0",
  "schemas": {
    "evidence_manifest": {
      "$defs": {
        "EvidenceArtifact": {
          "additionalProperties": false,
          "properties": {
            "media_type": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Media Type",
              "type": "string"
            },
            "name": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "title": "Name",
              "type": "string"
            },
            "relative_path": {
              "maxLength": 256,
              "minLength": 1,
              "title": "Relative Path",
              "type": "string"
            },
            "role": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]*$",
              "title": "Role",
              "type": "string"
            },
            "schema_version": {
              "const": "1.0",
              "default": "1.0",
              "title": "Schema Version",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Sha256",
              "type": "string"
            },
            "size_bytes": {
              "minimum": 0,
              "title": "Size Bytes",
              "type": "integer"
            }
          },
          "required": [
            "name",
            "role",
            "relative_path",
            "media_type",
            "sha256",
            "size_bytes"
          ],
          "title": "EvidenceArtifact",
          "type": "object"
        },
        "ExperimentLock": {
          "additionalProperties": false,
          "properties": {
            "algorithm_versions": {
              "additionalProperties": {
                "type": "string"
              },
              "title": "Algorithm Versions",
              "type": "object"
            },
            "code_commit": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Code Commit",
              "type": "string"
            },
            "configuration_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Configuration Hash",
              "type": "string"
            },
            "model_versions": {
              "additionalProperties": {
                "type": "string"
              },
              "title": "Model Versions",
              "type": "object"
            },
            "random_seeds": {
              "items": {
                "type": "integer"
              },
              "title": "Random Seeds",
              "type": "array"
            },
            "scenario_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Scenario Hash",
              "type": "string"
            },
            "schema_version": {
              "const": "1.0",
              "default": "1.0",
              "title": "Schema Version",
              "type": "string"
            },
            "software_versions": {
              "additionalProperties": {
                "type": "string"
              },
              "title": "Software Versions",
              "type": "object"
            }
          },
          "required": [
            "code_commit",
            "software_versions",
            "model_versions",
            "algorithm_versions",
            "scenario_hash",
            "configuration_hash",
            "random_seeds"
          ],
          "title": "ExperimentLock",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Applicability",
          "type": "array"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/EvidenceArtifact"
          },
          "minItems": 1,
          "title": "Artifacts",
          "type": "array"
        },
        "conclusion": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Conclusion",
          "type": "string"
        },
        "created_at_utc": {
          "format": "date-time",
          "title": "Created At Utc",
          "type": "string"
        },
        "experiment_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Experiment Id",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "lock": {
          "$ref": "#/$defs/ExperimentLock"
        },
        "requirements": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Requirements",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "experiment_id",
        "created_at_utc",
        "lock",
        "requirements",
        "applicability",
        "conclusion",
        "artifacts"
      ],
      "title": "EvidenceManifest",
      "type": "object"
    },
    "evidence_package": {
      "$defs": {
        "EvidenceArtifact": {
          "additionalProperties": false,
          "properties": {
            "media_type": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Media Type",
              "type": "string"
            },
            "name": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "title": "Name",
              "type": "string"
            },
            "relative_path": {
              "maxLength": 256,
              "minLength": 1,
              "title": "Relative Path",
              "type": "string"
            },
            "role": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]*$",
              "title": "Role",
              "type": "string"
            },
            "schema_version": {
              "const": "1.0",
              "default": "1.0",
              "title": "Schema Version",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Sha256",
              "type": "string"
            },
            "size_bytes": {
              "minimum": 0,
              "title": "Size Bytes",
              "type": "integer"
            }
          },
          "required": [
            "name",
            "role",
            "relative_path",
            "media_type",
            "sha256",
            "size_bytes"
          ],
          "title": "EvidenceArtifact",
          "type": "object"
        },
        "EvidenceManifest": {
          "additionalProperties": false,
          "properties": {
            "applicability": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "title": "Applicability",
              "type": "array"
            },
            "artifacts": {
              "items": {
                "$ref": "#/$defs/EvidenceArtifact"
              },
              "minItems": 1,
              "title": "Artifacts",
              "type": "array"
            },
            "conclusion": {
              "maxLength": 4096,
              "minLength": 1,
              "title": "Conclusion",
              "type": "string"
            },
            "created_at_utc": {
              "format": "date-time",
              "title": "Created At Utc",
              "type": "string"
            },
            "experiment_id": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Experiment Id",
              "type": "string"
            },
            "limitations": {
              "default": [],
              "items": {
                "type": "string"
              },
              "title": "Limitations",
              "type": "array"
            },
            "lock": {
              "$ref": "#/$defs/ExperimentLock"
            },
            "requirements": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "title": "Requirements",
              "type": "array"
            },
            "schema_version": {
              "const": "1.0",
              "default": "1.0",
              "title": "Schema Version",
              "type": "string"
            }
          },
          "required": [
            "experiment_id",
            "created_at_utc",
            "lock",
            "requirements",
            "applicability",
            "conclusion",
            "artifacts"
          ],
          "title": "EvidenceManifest",
          "type": "object"
        },
        "ExperimentLock": {
          "additionalProperties": false,
          "properties": {
            "algorithm_versions": {
              "additionalProperties": {
                "type": "string"
              },
              "title": "Algorithm Versions",
              "type": "object"
            },
            "code_commit": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Code Commit",
              "type": "string"
            },
            "configuration_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Configuration Hash",
              "type": "string"
            },
            "model_versions": {
              "additionalProperties": {
                "type": "string"
              },
              "title": "Model Versions",
              "type": "object"
            },
            "random_seeds": {
              "items": {
                "type": "integer"
              },
              "title": "Random Seeds",
              "type": "array"
            },
            "scenario_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Scenario Hash",
              "type": "string"
            },
            "schema_version": {
              "const": "1.0",
              "default": "1.0",
              "title": "Schema Version",
              "type": "string"
            },
            "software_versions": {
              "additionalProperties": {
                "type": "string"
              },
              "title": "Software Versions",
              "type": "object"
            }
          },
          "required": [
            "code_commit",
            "software_versions",
            "model_versions",
            "algorithm_versions",
            "scenario_hash",
            "configuration_hash",
            "random_seeds"
          ],
          "title": "ExperimentLock",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "$ref": "#/$defs/EvidenceManifest"
        },
        "package_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Package Hash",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "package_hash",
        "manifest"
      ],
      "title": "EvidencePackage",
      "type": "object"
    },
    "experiment_lock": {
      "additionalProperties": false,
      "properties": {
        "algorithm_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Algorithm Versions",
          "type": "object"
        },
        "code_commit": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Code Commit",
          "type": "string"
        },
        "configuration_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Hash",
          "type": "string"
        },
        "model_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Model Versions",
          "type": "object"
        },
        "random_seeds": {
          "items": {
            "type": "integer"
          },
          "title": "Random Seeds",
          "type": "array"
        },
        "scenario_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Scenario Hash",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "software_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Software Versions",
          "type": "object"
        }
      },
      "required": [
        "code_commit",
        "software_versions",
        "model_versions",
        "algorithm_versions",
        "scenario_hash",
        "configuration_hash",
        "random_seeds"
      ],
      "title": "ExperimentLock",
      "type": "object"
    }
  }
}
