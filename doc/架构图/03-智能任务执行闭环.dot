digraph MissionLoop {
  graph [rankdir=TB, bgcolor="#F4F7FA", pad="0.28", nodesep="0.3", ranksep="0.48", splines=ortho, fontname="Microsoft YaHei"];
  node [fontname="Microsoft YaHei"];
  edge [color="#6F8496", penwidth=2.2, arrowsize=0.85];

  title [shape=plain, label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4">
      <TR><TD><FONT POINT-SIZE="25" COLOR="#162638"><B>智能任务执行闭环</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="12" COLOR="#637486">从自然语言到物理飞行，再由真实遥测验证结果</FONT></TD></TR>
    </TABLE>
  >];

  planning [shape=plain, label=<
    <TABLE BORDER="1" COLOR="#C4D1DA" CELLBORDER="0" CELLSPACING="7" CELLPADDING="11" BGCOLOR="#E5EDF3">
      <TR><TD COLSPAN="9" ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#263D50"><B>01 任务理解与决策</B></FONT></TD></TR>
      <TR>
        <TD PORT="user" WIDTH="145" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>用户任务</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#617383">自然语言目标<BR/>约束与条件</FONT></TD>
        <TD WIDTH="28"><FONT POINT-SIZE="19" COLOR="#708596">→</FONT></TD>
        <TD WIDTH="145" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>LLM 理解</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#617383">识别意图<BR/>补全上下文</FONT></TD>
        <TD WIDTH="28"><FONT POINT-SIZE="19" COLOR="#708596">→</FONT></TD>
        <TD WIDTH="145" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>Workflow 规划</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#617383">组合 Skills<BR/>生成条件分支</FONT></TD>
        <TD WIDTH="28"><FONT POINT-SIZE="19" COLOR="#708596">→</FONT></TD>
        <TD WIDTH="145" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>结构化校验</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#617383">能力白名单<BR/>参数范围</FONT></TD>
        <TD WIDTH="28"><FONT POINT-SIZE="19" COLOR="#708596">→</FONT></TD>
        <TD PORT="confirm" WIDTH="145" BGCOLOR="#FFF6DF"><FONT POINT-SIZE="14"><B>风险确认</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#765B20">人工确认<BR/>或策略放行</FONT></TD>
      </TR>
    </TABLE>
  >];

  execution [shape=plain, label=<
    <TABLE BORDER="1" COLOR="#B7CDCF" CELLBORDER="0" CELLSPACING="7" CELLPADDING="11" BGCOLOR="#DDEBEC">
      <TR><TD COLSPAN="9" ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#263D50"><B>02 机器人执行与物理反馈</B></FONT></TD></TR>
      <TR>
        <TD PORT="dispatch" WIDTH="145" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>ROS 2 调度</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#617383">Service / Action<BR/>Topic / TF</FONT></TD>
        <TD WIDTH="28"><FONT POINT-SIZE="19" COLOR="#708596">→</FONT></TD>
        <TD WIDTH="145" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>实时感知</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#617383">RGB、深度<BR/>点云、检测</FONT></TD>
        <TD WIDTH="28"><FONT POINT-SIZE="19" COLOR="#708596">→</FONT></TD>
        <TD PORT="replan" WIDTH="145" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>自主规划</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#617383">避障重规划<BR/>Minimum Snap</FONT></TD>
        <TD WIDTH="28"><FONT POINT-SIZE="19" COLOR="#708596">→</FONT></TD>
        <TD WIDTH="145" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>轨迹跟踪</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#617383">连续 Offboard<BR/>位置速度设定值</FONT></TD>
        <TD WIDTH="28"><FONT POINT-SIZE="19" COLOR="#708596">→</FONT></TD>
        <TD PORT="vehicle" WIDTH="145" BGCOLOR="#E6F3EA"><FONT POINT-SIZE="14"><B>PX4 与无人机</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#3D6B50">姿态控制<BR/>执行物理动作</FONT></TD>
      </TR>
    </TABLE>
  >];

  verification [shape=plain, label=<
    <TABLE BORDER="1" COLOR="#C8D0D9" CELLBORDER="0" CELLSPACING="8" CELLPADDING="11" BGCOLOR="#E7EBF0">
      <TR><TD COLSPAN="7" ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#263D50"><B>03 结果验证与任务恢复</B></FONT></TD></TR>
      <TR>
        <TD PORT="telemetry" WIDTH="185" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>遥测与 Mission 状态</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#617383">高度、位置、模式、进度、完成原因</FONT></TD>
        <TD WIDTH="32"><FONT POINT-SIZE="19" COLOR="#708596">→</FONT></TD>
        <TD WIDTH="185" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="14"><B>条件判定</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#617383">是否达到目标？<BR/>是否需要恢复？</FONT></TD>
        <TD WIDTH="32"><FONT POINT-SIZE="19" COLOR="#708596">→</FONT></TD>
        <TD PORT="report" WIDTH="185" BGCOLOR="#E6F3EA"><FONT POINT-SIZE="14"><B>完成与归档</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#3D6B50">对话反馈、截图、日志、任务报告</FONT></TD>
        <TD PORT="recovery" WIDTH="185" BGCOLOR="#FFF6DF"><FONT POINT-SIZE="14"><B>可恢复异常</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#765B20">暂停、重试、局部重规划</FONT></TD>
        <TD PORT="stop" WIDTH="185" BGCOLOR="#FCE9E7"><FONT POINT-SIZE="14"><B>不可接受风险</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#7F4440">悬停、降落或 RTL</FONT></TD>
      </TR>
    </TABLE>
  >];

  guard [shape=plain, label=<
    <TABLE BORDER="1" COLOR="#D3BC80" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10" BGCOLOR="#FFF9EA">
      <TR>
        <TD WIDTH="260"><FONT POINT-SIZE="12"><B>决策边界</B><BR/>LLM 只生成结构化任务，不直接控制电机</FONT></TD>
        <TD WIDTH="260"><FONT POINT-SIZE="12"><B>执行边界</B><BR/>ROS 2 Action 持续反馈并支持取消和超时</FONT></TD>
        <TD WIDTH="260"><FONT POINT-SIZE="12"><B>安全边界</B><BR/>飞控状态、障碍距离与人工确认共同约束</FONT></TD>
      </TR>
    </TABLE>
  >];

  title -> planning [style=invis, weight=10];
  planning -> execution;
  execution -> verification;
  verification -> guard [style=invis, weight=8];
}
